{
  "theme": "light/dark",
  "enabledModels": [],
  "hideThinkingBlock": true,
  "steeringMode": "all",
  "followUpMode": "all",
  "quietStartup": false,
  "terminal": {
    "showTerminalProgress": true
  },
  "enableInstallTelemetry": false,
  "defaultProjectTrust": "always",
  "defaultTools": [
    "+codemode"
  ],
  "doubleEscapeAction": "tree",
  "tuiMode": "fullscreen",
  "compaction": {
    "enabled": true,
    "reserveTokens": 32768,
    "keepRecentTokens": 20000
  },
  "packages": [
    "npm:pi-blackhole",
    "npm:pi-web-access",
    "npm:@narumitw/pi-chrome-devtools",
    "npm:@narumitw/pi-lsp",
    "npm:pi-subagents"
  ]
}
