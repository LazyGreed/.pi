{
  "theme": "light/dark",
  "enabledModels": [
    "openai/gpt-6-luna",
    "openai/gpt-6.1-sol"
  ],
  "hideThinkingBlock": true,
  "steeringMode": "all",
  "followUpMode": "all",
  "quietStartup": false,
  "terminal": {
    "showTerminalProgress": true
  },
  "enableInstallTelemetry": false,
  "defaultProjectTrust": "always",
  "defaultTools": [
    "+codemode"
  ],
  "doubleEscapeAction": "tree",
  "tuiMode": "fullscreen",
  "defaultProvider": "openai",
  "defaultModel": "gpt-6.1-sol",
  "modelThinkingLevels": {
    "openai/gpt-6-luna": "max",
    "openai/gpt-6.1-sol": "high"
  },
  "compaction": {
    "enabled": true,
    "reserveTokens": 32768,
    "keepRecentTokens": 20000
  },
  "packages": [
    "npm:pi-blackhole",
    "npm:pi-web-access",
    "npm:@narumitw/pi-chrome-devtools",
    "git:github.com/nathanstephenson/pi-subagents",
    "npm:@narumitw/pi-lsp"
  ]
}
