{
  "name": "k-jev",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "pi": {
    "extensions": [
      "./src/pi.ts"
    ]
  },
  "exports": {
    "./pi": "./dist/pi.js",
    "./mcp": "./dist/mcp.js"
  },
  "scripts": {
    "build": "tsc",
    "test": "npm run build && node --test tests/*.test.ts",
    "check": "npm run build && tsc --ignoreConfig --noEmit --strict --skipLibCheck --module NodeNext --target ES2023 --types node tests/*.test.ts && biome check ."
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.3.0",
    "zod": "^4.6.5"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-ai": "*",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-ai": {
      "optional": true
    },
    "typebox": {
      "optional": true
    }
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.3.0",
    "@earendil-works/pi-coding-agent": "1.0.0",
    "@earendil-works/pi-ai": "1.0.0",
    "typebox": "1.3.27",
    "@types/node": "^24.0.0",
    "typescript": "^6.0.3",
    "@biomejs/biome": "^2.5.15"
  }
}
